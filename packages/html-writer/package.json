{
  "name": "@boxpdf/html-writer",
  "version": "0.2.2",
  "description": "Stream PDF pages from @boxpdf/reader to visual or semantic HTML.",
  "keywords": [
    "pdf",
    "pdf-to-html",
    "html-writer",
    "streaming-pdf",
    "text-extraction"
  ],
  "license": "MIT",
  "author": {
    "name": "Erik Aronesty",
    "email": "erik@q32.com"
  },
  "homepage": "https://github.com/earonesty/streaming-pdf-reader#html-writer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earonesty/streaming-pdf-reader.git",
    "directory": "packages/html-writer"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "build": "tsup",
    "check": "biome check --error-on-warnings . && tsc --noEmit",
    "test": "vitest run --coverage",
    "package:check": "publint && pnpm pack --dry-run",
    "quality": "pnpm check && pnpm test && pnpm build && pnpm package:check",
    "prepublishOnly": "pnpm quality"
  },
  "peerDependencies": {
    "@boxpdf/reader": "^0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@boxpdf/reader": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/pako": "2.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "publint": "^0.3.24",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0",
    "jpeg-js": "0.4.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pako": "2.2.0"
  }
}
